{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard
  "name": "versta-web",
  "compatibility_date": "2026-11-13",
  "main": "./worker/index.js",
  // public address versta-web.egor-andreevich2017.workers.dev (set false once a custom domain is attached, if you want)
  "workers_dev": true,
  // keep variables added in the Cloudflare dashboard when deploying from Git
  "keep_vars": true,
  // custom domain: Cloudflare creates the DNS record and the HTTPS certificate automatically
  "routes": [{ "pattern": "verstaweb.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    // pre-rendered pages + dist/404.html for unknown addresses
    "not_found_handling": "404-page",
    // only the form endpoint runs the Worker; everything else is served as static files
    "run_worker_first": true
  },
  // per-visitor limit for the form: 5 submissions per minute per IP
  "ratelimits": [
    { "name": "LEAD_LIMITER", "namespace_id": "4711", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
